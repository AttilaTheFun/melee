{
  "name": "melee-browser",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-01",
  "assets": {"directory": "../../build/wasm-site", "binding": "ASSETS", "run_worker_first": true},
  "durable_objects": {"bindings": [{"name": "ROOMS", "class_name": "MeleeRoom"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["MeleeRoom"]}],
  "ratelimits": [{"name": "ROOM_LIMITER", "namespace_id": "1001", "simple": {"limit": 6, "period": 60}}]
}
